From: Jennifer Herbert <jennifer.herbert@cloud.com>
Subject: Create a domctl to allow PCI config writes/reads

As part of PCI passthrough, QEMU currently accesses
/sys/bus/pci/devices/<domain>:<bus>:<dev>.<func>/config. This is problematic
because it cannot be accessed when kernel lockdown mode is enabled.

While it may be preferable to filter the accesses in the dom0 kernel, this is
difficult for two reasons:
1) The sysfs config space interface is generic which means it would instead
require a new Xen-specific interface in the kernel to allow and filter these
accesses.
2) Filtering requires knowing which parts of config space userspace is allowed
to access which requires knowing the domains to which devices are assigned.
Keeping this information in sync with Xen in a race-free way may be difficult.

Ultimately, the correct solution will probably be to reimplement passthrough
using VFIO. In the meantime, resolve this issue with a local patch by creating
a new domctl that allows QEMU to read/write the PCI device config space for
devices assigned to a particular domain.

This op would allow writing up to 8 bytes to the device at the given address.

This interface would not allow writing to dom0's devices.

Signed-off-by: Jennifer Herbert <jennifer.herbert@cloud.com>
Signed-off-by: Ross Lagerwall <ross.lagerwall@citrix.com>
diff --git a/tools/include/xenctrl.h b/tools/include/xenctrl.h
index fcafdb3945f7..143061765714 100644
--- a/tools/include/xenctrl.h
+++ b/tools/include/xenctrl.h
@@ -2672,6 +2672,26 @@ int xc_dt_overlay_domain(xc_interface *xch, void *overlay_fdt,
                          uint32_t domain_id);
 #endif
 
+
+/**
+ * Read or Write the PCI config for the given pci device.
+ * @parm xch a handle to an open xenctrl interface.
+ * @parm domid the domain id to be serviced
+ * @parm segment the PCI segment number of the emulated device
+ * @parm bus the PCI bus number of the emulated device
+ * @parm device the PCI device number of the emulated device
+ * @parm func PCI function number of the emulated device
+ * @parm size number of bytes to be access, 1 to 8.
+ * @parm dir if to read (1), write (2) or both (3)
+ * @parm pos the position within the config to access
+ * @parm a pointer to the data to be read or written
+ * @return 0 on success, -1 on failure.
+ */
+int xc_domain_pci_access(xc_interface *xch,
+                         domid_t domid, uint16_t segment, uint8_t bus,
+                         uint8_t device, uint8_t func, uint8_t size,
+                         uint8_t dir, uint32_t pos, uint64_t *pcidata);
+
 /* Compat shims */
 #include "xenctrl_compat.h"
 
diff --git a/tools/libs/ctrl/xc_domain.c b/tools/libs/ctrl/xc_domain.c
index 176fca0bcbe9..e7cca3df44d4 100644
--- a/tools/libs/ctrl/xc_domain.c
+++ b/tools/libs/ctrl/xc_domain.c
@@ -2218,6 +2218,35 @@ int xc_domain_soft_reset(xc_interface *xch,
     domctl.domain = domid;
     return do_domctl(xch, &domctl);
 }
+
+int xc_domain_pci_access(xc_interface *xch,
+                         domid_t domid, uint16_t segment, uint8_t bus,
+                         uint8_t device, uint8_t func, uint8_t size,
+                         uint8_t dir, uint32_t pos, uint64_t *pcidata)
+{
+    int rc;
+    struct xen_domctl domctl = {};
+    xen_domctl_pci_access_t *op = &domctl.u.pci_access;
+
+    domctl.cmd = XEN_DOMCTL_pci_access;
+    domctl.domain = domid;
+
+    op->seg = segment;
+    op->bus = bus;
+    op->dev = device;
+
+    op->func = func;
+    op->size = size;
+    op->direction = dir;
+    op->pos = pos;
+
+    op->data = *pcidata;
+
+    rc = do_domctl(xch, &domctl);
+
+    *pcidata = op->data;
+    return rc;
+}
 /*
  * Local variables:
  * mode: C
diff --git a/xen/arch/x86/domctl.c b/xen/arch/x86/domctl.c
index 44055c8ede85..836c145cac47 100644
--- a/xen/arch/x86/domctl.c
+++ b/xen/arch/x86/domctl.c
@@ -196,6 +196,127 @@ static int do_vmtrace_op(struct domain *d, struct xen_domctl_vmtrace_op *op,
     return rc;
 }
 
+static bool check_for_bar_access(struct pci_dev *pdev, uint32_t pos)
+{
+    uint8_t header_type;
+
+    if ( pos < PCI_BASE_ADDRESS_0 || pos > PCI_BASE_ADDRESS_5 )
+        return false;
+
+    header_type = (pci_conf_read8(pdev->sbdf, PCI_HEADER_TYPE) & 0x7f);
+
+    if ( header_type == PCI_HEADER_TYPE_NORMAL )
+        return true;
+
+    if ( header_type == PCI_HEADER_TYPE_BRIDGE &&
+         ( pos == PCI_BASE_ADDRESS_0 || pos == PCI_BASE_ADDRESS_1 ) )
+        return true;
+
+    if ( header_type == PCI_HEADER_TYPE_CARDBUS && pos == PCI_BASE_ADDRESS_0 )
+        return true;
+
+    return false;
+}
+
+static int pci_access(struct domain *d,
+                      uint16_t seg, uint8_t bus, uint8_t dev, uint8_t func,
+                      uint8_t size, uint8_t dir, uint32_t pos, uint64_t *data)
+{
+    struct pci_dev *pdev;
+    int rc = 0;
+    pci_sbdf_t sbdf;
+
+    if ( is_hardware_domain(d) || is_control_domain(d) )
+        return -EACCES;
+
+    if ( size != 1 && size != 2 && size != 4 && size != 8 )
+        return -EFAULT;
+
+    if ( dir == 0 || dir & ~3 )
+        return -EINVAL;
+
+    sbdf = PCI_SBDF(seg, bus, dev, func);
+    pcidevs_lock();
+    pdev = pci_get_pdev(NULL, sbdf);
+
+    if ( !pdev )
+    {
+        rc = -ENXIO;
+        goto out;
+    }
+
+    if ( pdev->domain != d )
+    {
+        rc = -EACCES;
+        goto out;
+    }
+
+    if ( dir & XEN_DOMCTL_pci_write )
+    {
+        if ( check_for_bar_access(pdev, pos) )
+        {
+            rc = -EACCES;
+        }
+        else if ( size <= 4 )
+        {
+            rc = pci_conf_write_intercept(seg, sbdf.bdf, pos, size,
+                                          (uint32_t *)data);
+            if ( rc >= 0)
+            {
+                rc = 0;
+                switch (size)
+                {
+                case 1:
+                    pci_conf_write8(sbdf, pos, (uint8_t) *data);
+                    break;
+                case 2:
+                    pci_conf_write16(sbdf, pos, (uint16_t) *data);
+                    break;
+                case 4:
+                    pci_conf_write32(sbdf, pos, (uint32_t) *data);
+                    break;
+                }
+            }
+        }
+        else
+        {
+            if ( (rc = pci_conf_write_intercept(seg, sbdf.bdf, pos, 4,
+                                                (uint32_t *)data)) >= 0 &&
+                 (rc = pci_conf_write_intercept(seg, sbdf.bdf, pos + 4, 4,
+                                                ((uint32_t *)data) + 1)) >= 0 )
+            {
+                rc = 0;
+                pci_conf_write32(sbdf, pos, (uint32_t) *data);
+                pci_conf_write32(sbdf, pos + 4, (uint32_t) (*data >> 32) );
+            }
+        }
+    }
+
+    if ( dir & XEN_DOMCTL_pci_read )
+    {
+        switch (size)
+        {
+        case 1:
+            *data = (uint64_t) pci_conf_read8(sbdf,  pos);
+            break;
+        case 2:
+            *data = (uint64_t) pci_conf_read16(sbdf, pos);
+            break;
+        case 4:
+            *data = (uint64_t) pci_conf_read32(sbdf, pos);
+            break;
+        case 8:
+            *data = (uint64_t) pci_conf_read32(sbdf, pos);
+            *data |= ((uint64_t) pci_conf_read32(sbdf, pos + 4)) << 32;
+            break;
+        }
+    }
+
+out:
+    pcidevs_unlock();
+    return rc;
+}
+
 #define MAX_IOPORTS 0x10000
 
 long arch_do_domctl(
@@ -1319,6 +1440,26 @@ long arch_do_domctl(
             copyback = true;
         break;
 
+    case XEN_DOMCTL_pci_access:
+    {
+        struct xen_domctl_pci_access *data =
+            &domctl->u.pci_access;
+
+        ret = -EINVAL;
+
+        if ( data->pad0 || data->pad1 )
+            break;
+
+        ret = pci_access(d, data->seg, data->bus,
+                         data->dev, data->func, data->size, data->direction,
+                         data->pos, &data->data);
+
+        if ( !ret && data->direction & XEN_DOMCTL_pci_read)
+            copyback = true;
+
+        break;
+    }
+
     default:
         ret = -ENOSYS;
         break;
diff --git a/xen/include/public/domctl.h b/xen/include/public/domctl.h
index 75e676d48205..897a9edfa2c1 100644
--- a/xen/include/public/domctl.h
+++ b/xen/include/public/domctl.h
@@ -1258,6 +1258,37 @@ DEFINE_XEN_GUEST_HANDLE(xen_domctl_runstate_info_t);
 /* Some vcpus are runnable, some are blocked */
 #define DOMAIN_RUNSTATE_partial_contention 5
 
+/*
+ * XEN_DOMCTL_pci_access: Access the PCI config space of a device on behalf of
+ *                        domain.
+ *
+ * The PCI device must have already have been assigned to the domain passed.
+ */
+
+struct xen_domctl_pci_access {
+      /* IN */
+
+      /* PCI address */
+      uint16_t seg;      /* AKA PCI domain */
+      uint8_t bus;
+      uint8_t dev;
+      uint8_t func;
+
+      uint8_t size;      /* bytes to read/write 1/2/4/8 */
+      uint8_t direction; /* XEN_DMOP_pci_read or XEN_DMOP_pci_write */
+      uint8_t pad0;
+
+      uint32_t pos;      /* bytes into config to read/write */
+      uint32_t pad1;
+
+      /* IN/OUT */
+      uint64_t data;
+};
+typedef struct xen_domctl_pci_access xen_domctl_pci_access_t;
+
+#define XEN_DOMCTL_pci_read  1
+#define XEN_DOMCTL_pci_write 2
+
 struct xen_domctl {
     uint32_t cmd;
 #define XEN_DOMCTL_createdomain                   1
@@ -1351,6 +1382,7 @@ struct xen_domctl {
 #define XEN_DOMCTL_gdbsx_pausevcpu             1001
 #define XEN_DOMCTL_gdbsx_unpausevcpu           1002
 #define XEN_DOMCTL_gdbsx_domstatus             1003
+#define XEN_DOMCTL_pci_access                  1100
     uint32_t interface_version; /* XEN_DOMCTL_INTERFACE_VERSION */
     domid_t  domain;
     uint16_t _pad[3];
@@ -1413,6 +1445,7 @@ struct xen_domctl {
 #if defined(__arm__) || defined(__aarch64__)
         struct xen_domctl_dt_overlay        dt_overlay;
 #endif
+        struct xen_domctl_pci_access        pci_access;
         uint8_t                             pad[128];
     } u;
 };
